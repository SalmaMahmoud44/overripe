--- !u!114 &1771094582
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1771094580}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7821d22a9521d124fa74a6fe50c8a2ca, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TripleBDialogueTrigger
  introMessages:
  - actorId: 0
    message: What is a sweet banana like you doing in this sour orange nation?
    waitForAction: 1
    LockPlayerControls: 1
  - actorId: 1
    message: I was wondering the same.
    waitForAction: 1
    LockPlayerControls: 1
  - actorId: 0
    message: ...
    waitForAction: 1
    LockPlayerControls: 1
  - actorId: 1
    message: Never mind. I was on my way to the apple nation.
    waitForAction: 1
    LockPlayerControls: 1
  - actorId: 0
    message: Why?
    waitForAction: 1
    LockPlayerControls: 1
  - actorId: 1
    message: An apple stole our artifact.
    waitForAction: 1
    LockPlayerControls: 1
  - actorId: 0
    message: '*gasp* It seems like it''s a...'
    waitForAction: 1
    LockPlayerControls: 1
  - actorId: 0
    message: Bad Apple...
    waitForAction: 1
    LockPlayerControls: 1
  - actorId: 2
    message: Oh, I forgot to introduce myself! I'm Baron Banana the Billionaire!
    waitForAction: 1
    LockPlayerControls: 1
  - actorId: 2
    message: But you can call me <color=#FFD54F>Triple B</color> for short.
    waitForAction: 1
    LockPlayerControls: 1
  - actorId: 2
    message: I can help you get your artifact back. Bananas help each other, after
      all.
    waitForAction: 1
    LockPlayerControls: 1
  tutorialMessages:
  - actorId: 2
    message: Alright! If I'm going to help you, I should probably teach you how to
      use my ability.
    waitForAction: 1
    LockPlayerControls: 1
  - actorId: 2
    message: 'Just aim your cursor at the enemy you want to hit and press E and I''ll
      take care of the rest! '
    waitForAction: 7
    LockPlayerControls: 0
  afterLaserMessages:
  - actorId: 2
    message: Nice!
    waitForAction: 0
    LockPlayerControls: 1
  - actorId: 2
    message: But keep in mind... using my ability costs some of your time.
    waitForAction: 0
    LockPlayerControls: 1
  - actorId: 2
    message: So use it wisely!
    waitForAction: 0
    LockPlayerControls: 1
  - actorId: 2
    message: Let's go!
    waitForAction: 0
    LockPlayerControls: 1
  actors:
  - name: '?'
    sprite: {fileID: 3414708698566091530, guid: 20672652ea7688e4baff52851b950820, type: 3}
  - name: Banana
    sprite: {fileID: -5150704196045627465, guid: 30fef647e723505418356b4ef12293d1, type: 3}
  - name: Triple B
    sprite: {fileID: 3414708698566091530, guid: 20672652ea7688e4baff52851b950820, type: 3}
  dialougeManager: {fileID: 1330562766}
  tripleBFollow: {fileID: 1868642896}
  tripleBLaser: {fileID: 1868642892}
